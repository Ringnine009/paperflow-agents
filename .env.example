# PaperFlow configuration — copy to `.env` and fill in your values.
# `.env` is git-ignored: never commit it.

# Required: DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional overrides
# PAPERFLOW_API_BASE=https://api.deepseek.com/v1
# PAPERFLOW_MODEL=deepseek-chat
# PAPERFLOW_MAX_FULLTEXT_CHARS=60000
# PAPERFLOW_HTTP_TIMEOUT=90
